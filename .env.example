# Copy to `.env` (same folder as powerbi_rest_client.py) and fill in locally.
# `.env` is git-ignored. NEVER put tokens, passwords or client secrets here:
# authentication uses the existing Azure CLI session (az login --allow-no-subscriptions).

# --- Power BI Service (REST, read-only) --------------------------------------
POWERBI_DATASET_ID=<semantic-model-guid>
POWERBI_TENANT_ID=<tenant-guid-optional>
# POWERBI_WORKSPACE_ID=<workspace-guid-optional; not used by executeQueries on My workspace>
# POWERBI_API_BASE=https://api.powerbi.com/v1.0/myorg
# POWERBI_RESOURCE=https://analysis.windows.net/powerbi/api

# --- Local tooling -------------------------------------------------------------
# AZURE_CLI_PATH=C:\Program Files\Microsoft SDKs\Azure\CLI2\wbin\az.cmd
# REPORT_FONT_DIR=<folder with Carlito*.ttf>

# --- Private data location (outside the repository) ----------------------------
# Root folder that contains: Historic Reports\, Transacciones Money Pro\, Documentos ...\
# Default when unset: the parent folder of this repository.
# FINANCE_DATA_ROOT=<path-to-private-finance-folder>
# MP_DIR=<path-to-MoneyPro-folder>   (tests; default: $FINANCE_DATA_ROOT\Transacciones Money Pro)
